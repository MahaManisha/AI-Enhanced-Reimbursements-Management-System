# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=super-secret-session-key-change-in-production-2026
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# MongoDB Atlas Configuration
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.gse3wum.mongodb.net/reimbursement_db?retryWrites=true&w=majority
MONGO_DB_NAME=reimbursement_db

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Machine Learning Configuration
ML_MODEL_PATH=ml/saved_models/random_forest_reimbursement.joblib
ML_METADATA_PATH=ml/saved_models/pipeline_metadata.joblib

# Generative AI Configuration
# Providers: 'gemini' | 'openai' | 'groq' | 'fallback'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
# Alternative OpenAI / Groq compatible settings:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
